[Unit]
Description=Pilgrim Pantry Flask application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pilgrim
Group=pilgrim
WorkingDirectory=/opt/pilgrim/app
EnvironmentFile=/etc/pilgrim/app.env
ExecStart=/opt/pilgrim/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 app:app
StandardOutput=append:/var/log/pilgrim/app.log
StandardError=append:/var/log/pilgrim/app-error.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target