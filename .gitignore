# Secrets and local env files (never commit real credentials)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
terraform/terraform.env

# Private keys
*.pem
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Terraform state/config (contains sensitive values, regenerated locally/in CI)
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
terraform/*.tfvars
!terraform/*.tfvars.example

# Python virtualenv/cache
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Local SQLite dev database and logs
shop.db
*.sqlite
*.sqlite3
*.log

# Misc
node_modules/
.DS_Store
Thumbs.db
