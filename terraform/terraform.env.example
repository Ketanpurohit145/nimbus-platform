# Copy this file to terraform.env, replace the SSH CIDR, then source it.
export AWS_PROFILE=nimbus
export TF_VAR_aws_region=us-east-1
export TF_VAR_db_name={}
export TF_VAR_db_username={}
export TF_VAR_db_instance_class=db.t4g.micro
export TF_VAR_db_allocated_storage=20
export TF_VAR_key_name={}
export TF_VAR_public_key_path="$HOME/.ssh/pilgrim-key.pub"
export TF_VAR_allowed_ssh_cidrs='["REPLACE_WITH_YOUR_PUBLIC_IP/32"]'

read -r -s -p "RDS master password: " TF_VAR_db_password
printf '\n'
export TF_VAR_db_password
