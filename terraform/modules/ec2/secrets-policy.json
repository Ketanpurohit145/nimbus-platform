{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "secretsmanager.${region}.amazonaws.com"
          ],
          "kms:EncryptionContext:SecretARN": [
            "${master_secret_arn}",
            "${app_secret_arn}"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "${master_secret_arn}",
        "${app_secret_arn}"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "secretsmanager:PutSecretValue"
      ],
      "Resource": [
        "${app_secret_arn}"
      ]
    }
  ]
}
